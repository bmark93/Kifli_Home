# =============================================================================
# LLM Beállítások (Google Gemini 2.5 Flash VAGY OpenAI gpt-4.1-mini)
# Mindkettő pay-as-you-go API kulccsal privát (nem tanít az adataidon) és ~30-150 Ft/hó!
# =============================================================================
# Választható: gemini | openai | custom
LLM_PROVIDER=gemini

# Ha LLM_PROVIDER=gemini (Google AI Studio / Vertex pay-as-you-go API kulcs):
GEMINI_API_KEY=AIzaSy_IDE_JON_A_SAJAT_KULCSOD
GEMINI_MODEL=gemini-3.1-flash-lite

# Ha LLM_PROVIDER=openai:
OPENAI_API_KEY=sk-IDE_JON_A_SAJAT_KULCSOD
OPENAI_MODEL=gpt-4.1-mini

# Ha LLM_PROVIDER=custom (pl. M4 MacBook Air Ollama teszteléshez):
CUSTOM_LLM_BASE_URL=http://host.docker.internal:11434/v1
CUSTOM_LLM_API_KEY=ollama
CUSTOM_LLM_MODEL=qwen2.5:14b

# =============================================================================
# Kifli.hu Hivatalos MCP Szerver (OAuth 2.1 PKCE automatikus token frissítéssel)
# =============================================================================
KIFLI_MCP_URL=https://mcp.kifli.hu/mcp
KIFLI_OAUTH_REDIRECT_URI=http://localhost:3334/oauth/callback

# =============================================================================
# Privát Telegram Bot (Hétfő reggeli menü értesítés + Chat vezérlés)
# Készíts egy botot @BotFather-nél, a saját numeric ID-dat pedig nézd meg @userinfobot-tal!
# =============================================================================
TELEGRAM_BOT_TOKEN=
# Vesszővel elválasztott engedélyezett Telegram user ID-k (pl. te + párod: 12345678,87654321)
TELEGRAM_ALLOWED_USER_IDS=

# =============================================================================
# Hétfő reggeli menütervező ütemezés & Belső hálózati védelem
# =============================================================================
TIMEZONE=Europe/Budapest
WEEKLY_MENU_CRON_DAY=mon
WEEKLY_MENU_CRON_HOUR=8
WEEKLY_MENU_CRON_MINUTE=0

# =============================================================================
# Multi-User Hitelesítés, Demo Sandbox & AI Költségvédelem
# =============================================================================
# true = Szép Login / Regisztráció oldal minden usernek (ajánlott publikus/megosztott hoszthoz!)
# false = Egyszemélyes, belépés nélküli otthoni LAN mód
AUTH_REQUIRED=true

# Opcionális meghívókód regisztrációhoz (ha üres, bárki regisztrálhat; ha kitöltöd, csak a kód birtokosai!)
INVITE_CODE=

# 0 Ft-os "Belépés Google-fiókkal" (Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID)
# Authorized redirect URI: https://<te-domain-ed>/api/auth/google/callback (vagy http://127.0.0.1:8085/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcionális felülírás (ha üres, automatikusan az aktuális domainből képzi)
GOOGLE_REDIRECT_URI=
# Opcionális vesszővel elválasztott engedélyezett Gmail címek (ha üres, bármelyik Google fiók beléphet!)
ALLOWED_GOOGLE_EMAILS=

# Titkos kulcs session cookie-khoz és per-user AI API kulcsok AES titkosításához
# (Ha üres, automatikusan generál és elment egyet a ./data/.app_secret fájlba)
APP_SECRET_KEY=

# 1-kattintásos izolált "Kifli Demo" gomb a Login oldalon (tökéletes a Kiflinek / haveroknak!)
DEMO_MODE_ENABLED=true
# Napi AI hívás limit a Demo fióknak és a szerver AI kulcsát használó vendégeknek (költségvédelem!)
DEMO_DAILY_AI_LIMIT=8
SERVER_FALLBACK_DAILY_AI_LIMIT=15

# Opcionális PIN kód (csak AUTH_REQUIRED=false módban aktív)
APP_ACCESS_PIN=

# Külön titkos kulcs KIZÁRÓLAG a publikus /mcp/<TOKEN> végponthoz (Claude mobil app / Tailscale Funnel)!
# Csak betűk és számok (pl. 9xK7mP4vQ2nL8wR5tY3jH6fD1sG0bVcZ)
MCP_ACCESS_TOKEN=

# Adatmappa (SQLite adatbázis + Kifli OAuth tokenek)
DATA_DIR=./data
PORT=8085
