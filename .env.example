# =============================================================================
# LLM Beállítások (Google Gemini 2.5 Flash VAGY OpenAI gpt-4.1-mini)
# Mindkettő pay-as-you-go API kulccsal privát (nem tanít az adataidon) és ~30-150 Ft/hó!
# =============================================================================
# Választható: gemini | openai | custom
LLM_PROVIDER=gemini

# Ha LLM_PROVIDER=gemini (Google AI Studio / Vertex pay-as-you-go API kulcs):
GEMINI_API_KEY=AIzaSy_IDE_JON_A_SAJAT_KULCSOD
GEMINI_MODEL=gemini-3.1-flash-lite

# Ha LLM_PROVIDER=openai:
OPENAI_API_KEY=sk-IDE_JON_A_SAJAT_KULCSOD
OPENAI_MODEL=gpt-4.1-mini

# Ha LLM_PROVIDER=custom (pl. M4 MacBook Air Ollama teszteléshez):
CUSTOM_LLM_BASE_URL=http://host.docker.internal:11434/v1
CUSTOM_LLM_API_KEY=ollama
CUSTOM_LLM_MODEL=qwen2.5:14b

# =============================================================================
# Kifli.hu Hivatalos MCP Szerver (OAuth 2.1 PKCE automatikus token frissítéssel)
# =============================================================================
KIFLI_MCP_URL=https://mcp.kifli.hu/mcp
KIFLI_OAUTH_REDIRECT_URI=http://localhost:3334/oauth/callback

# =============================================================================
# Privát Telegram Bot (Hétfő reggeli menü értesítés + Chat vezérlés)
# Készíts egy botot @BotFather-nél, a saját numeric ID-dat pedig nézd meg @userinfobot-tal!
# =============================================================================
TELEGRAM_BOT_TOKEN=
# Vesszővel elválasztott engedélyezett Telegram user ID-k (pl. te + párod: 12345678,87654321)
TELEGRAM_ALLOWED_USER_IDS=

# =============================================================================
# Hétfő reggeli menütervező ütemezés & Belső hálózati védelem
# =============================================================================
TIMEZONE=Europe/Budapest
WEEKLY_MENU_CRON_DAY=mon
WEEKLY_MENU_CRON_HOUR=8
WEEKLY_MENU_CRON_MINUTE=0

# Opcionális PIN kód a webes felülethez (hagyd üresen, ha Tailscale/VPN mögött nem kérsz PIN-t)
APP_ACCESS_PIN=

# Adatmappa (SQLite adatbázis + Kifli OAuth tokenek)
DATA_DIR=./data
PORT=8085
